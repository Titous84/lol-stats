# ---------------------------------------------------------------------------
# lol-stats — copier vers .env.local (jamais commité)
# ---------------------------------------------------------------------------

# Clé Riot. https://developer.riotgames.com/
# Une clé de DEVELOPPEMENT expire toutes les 24 h -> a recoller chaque jour.
# Demander une cle PERSONNELLE (n'expire pas) : voir TODO.md point 3.
# Aucune variable NEXT_PUBLIC_* ne doit jamais contenir cette valeur.
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Compte suivi
RIOT_GAME_NAME=TikaSama
RIOT_TAG_LINE=DME

# Routage Riot. NA -> plateforme na1, regional americas.
RIOT_PLATFORM=na1
RIOT_REGION=americas

# Files ingerees, separees par des virgules. 420 = solo/duo, 440 = flex.
INGEST_QUEUES=420,440

# Base SQLite, relatif a la racine du projet.
DATABASE_PATH=./data/lol-stats.db

# Serveur : 127.0.0.1 uniquement. Ne jamais mettre 0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Affichage
DISPLAY_TIMEZONE=America/Toronto

# Limites internes de la recherche de joueur (protege le quota Riot).
SEARCH_RATE_PER_MINUTE=10
SEARCH_RATE_PER_HOUR=60

# Journalisation du collecteur : debug | info | warn | error
INGEST_LOG_LEVEL=info
